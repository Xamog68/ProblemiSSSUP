\newcommand{\IniziaGS}[2]{
	\begin{center}
		\underline{\parbox{\textwidth}{\vspace{-2ex}
		\begin{center}
			{\LARGE Prova di Ammissione -- Anno #1}
		\end{center}
% 		\begin{quote}
% 			\textbf{Difficolt\`{a}}: #2
% 		\end{quote}
		}}
	\end{center}
	\medskip
	\renewcommand{\Fondo}{$\overline{\parbox{\textwidth}{\mbox{}\rule{0ex}{2ex}
	\hfill\textbf{Testo Prova di Ammissione alla SSSUP -- Anno #1}\hfill\mbox{}}}$}
}

\newcommand{\IniziaGSR}[1]{
	\begin{center}
		\underline{\parbox{\textwidth}{\vspace{-2ex}
		\begin{center}
			{\LARGE #1 -- Risposte}
		\end{center}
% 		\begin{quote}
% 			\textbf{Tempo concesso}: 90 minuti\medskip\\
% 			\textbf{Valutazione}: risposta errata $0$ punti, mancante
% 			$+2$, esatta $+5$
% 		\end{quote}
		}}
	\end{center}
	\medskip
	\renewcommand{\Fondo}{$\overline{\parbox{\textwidth}{\mbox{}\rule{0ex}{2ex}
	\hfill\textbf{Prova di Ammissione -- Anno #1}\hfill\mbox{}}}$}
}

\newcommand{\AggiungiGS}[3]
{ 
	\IniziaGS{#2}{#3}
	\input{\Percorso#1}
}

\newcommand{\AggiungiGSR}[2]
{ 
	\IniziaGSR{#2}
	\input{\Percorso#1}
}

